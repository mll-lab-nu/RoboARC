# Harbor forwards these into the agent container. Copy to .env (gitignored) or export them.
ANTHROPIC_API_KEY=            # or CLAUDE_CODE_OAUTH_TOKEN=... with CLAUDE_FORCE_OAUTH=1
OPENAI_API_KEY=               # or CODEX_FORCE_AUTH_JSON=1 to reuse ~/.codex/auth.json (ChatGPT login)
DEEPSEEK_API_KEY=             # AGENT=dsh (DSH, the DeepSeek Harness: scripts/harbor/agents/dsh_acp.py)
ANTIGRAVITY_BASE_URL=         # AGENT=antigravity: the Chat Completions server's plain-HTTP base with a port, e.g. http://127.0.0.1:4141/v1
GEMINI_API_KEY=               # AGENT=antigravity: the key that server expects (at least 16 characters; any value if it needs none)
KIMI_API_KEY=                 # AGENT=kimi-code (Kimi Code CLI: scripts/harbor/agents/kimi_code_cli.py): a Moonshot API key
KIMI_BASE_URL=                # AGENT=kimi-code: unset = https://api.moonshot.ai/v1; https://api.moonshot.cn/v1 for Moonshot's China platform
# Through OpenRouter instead: the OpenRouter key as OPENAI_API_KEY with OPENAI_BASE_URL=https://openrouter.ai/api/v1
# (Codex), and as ANTHROPIC_API_KEY with ANTHROPIC_BASE_URL=https://openrouter.ai/api (Claude Code).
