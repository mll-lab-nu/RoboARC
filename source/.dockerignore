# Build context of the RoboARC release image (images/roboarc/build.sh builds images/robotangle/Dockerfile.mujoco from
# source/): only what the recipe COPYs.
**
!assets/
!assets/robots/
!assets/robots/**
!images/robotangle/prune.py
!images/robotangle/vbd-requirements.txt
!images/robotangle/warp_precompile.py
!images/robotangle/mujoco-3.14.0-epa/
!images/robotangle/mujoco-3.14.0-epa/bytepatch_libmujoco.py
!topogym/
!topogym/**
# no solutions in any image (images/robotangle/prune.py removes them again after COPY)
topogym/agents
topogym/planning
topogym/data
topogym/**/deferred
topogym/**/legacy
topogym/**/redundants
topogym/**/rollout_simulation
**/*.md
# Relay robot identity includes the original robot documentation bytes.
!assets/robots/**/*.md
**/__pycache__/**
**/*.pyc
**/.env*
**/.secrets/**
