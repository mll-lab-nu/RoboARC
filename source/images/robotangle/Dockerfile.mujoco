# The RoboARC release image: the published Genesis base image (RoboTangle 0.2.22, pinned by digest below) plus
#   - the simulator source (topogym/, with the MuJoCo core topogym/world/mujoco/), pruned by images/topogym/prune.py:
#     /opt/topogym/SOURCE.json is its hash, which every task's runtime binding names;
#   - the robot assets (assets/robots/ -> /opt/topogym-assets/robots/, TOPOGYM_ASSET_ROOT);
#   - the frozen MuJoCo instances (the named build context `instances`, one directory per task base: instance.json +
#     instance_assets/), each replacing the Genesis instance of the same base in /opt/robotangle/instances/
#     (/opt/robotangle/stage_instance.py, from the base image, stages it into the task). An empty context builds the
#     image without them: tools/release/release_rebuild.py makes new instances inside that image, then builds it again
#     with them (every layer but the last is shared, so both have the same runtime);
#   - the VBD cloth: newton 1.6.1 and warp-lang 1.18.0 (vbd-requirements.txt, exact versions and wheel hashes) and
#     their Warp CPU kernels, compiled at build into the read-only cache /opt/warp-cache (WARP_CACHE_PATH) with the
#     pinned target of topogym/world/mujoco/warp_cpu.py (docs/simulator/VBD_CLOTH.md).
# Everything else is the base image: Genesis 1.2.1 and gs-nyx (the render bridge's Nyx host), libuipc, torch, and the
# MuJoCo the core is pinned to, mujoco 3.14.0 (a genesis-world dependency; docs/simulator/MUJOCO_CORE.md; its
# libmujoco.so gets the EPA fix, below), plus coacd. The base was published as ghcr.io/mll-lab-nu/eai-robotangle:0.2.22;
# the same image (same digest) is in the public package ghcr.io/mll-lab-nu/efe as robotangle-0.2.22. Its recipe:
# images/roboarc/Dockerfile.genesis-0.2.22.
# The numpy / OpenBLAS SIMD masking of the MuJoCo tasks (NPY_DISABLE_CPU_FEATURES, OPENBLAS_CORETYPE) is NOT set here:
# it belongs to the tasks' containers (agent, sim, verifier); the task generator writes it (scripts/roboarc/mk_tasks.py).
#
# Build: images/roboarc/build.sh (the release build, with the runtime check), which runs from source/ (this directory's
# parent's parent; source/.dockerignore keeps the context to topogym/, assets/robots/ and the helper files the
# recipe copies). Keep the bytes and paths of every COPY input when editing: a changed input misses the build
# cache, and a cache-cold build writes .pyc files whose source-mtime field differs from the released image's.
#   docker buildx build --load -f images/robotangle/Dockerfile.mujoco --build-context instances=<dir of instance bases> \
#     -t <tag> .
ARG BASE=ghcr.io/mll-lab-nu/efe:robotangle-0.2.22@sha256:eb1a75177bf3d11f60540ef5a285c5a47d8cf35e2e99630759bb108b9f05dfad
FROM ${BASE} AS unsquashed
RUN python -c "import mujoco, coacd; assert mujoco.__version__ == '3.14.0', mujoco.__version__"
# before the simulator source, so this layer survives source changes
COPY images/robotangle/vbd-requirements.txt /tmp/vbd-requirements.txt
RUN python -m pip install --no-cache-dir --no-deps --require-hashes -r /tmp/vbd-requirements.txt && rm /tmp/vbd-requirements.txt \
 && python -c "from importlib.metadata import version as v; assert (v('newton'), v('warp-lang')) == ('1.6.1', '1.18.0')"
RUN rm -rf /opt/topogym/topogym /opt/topogym/SOURCE.json /opt/topogym-assets/robots
COPY topogym/ /opt/topogym/topogym/
COPY images/topogym/prune.py /opt/prune.py
RUN python /opt/prune.py /opt/topogym && rm /opt/prune.py && chmod -R a+rX /opt/topogym
COPY assets/robots/ /opt/topogym-assets/robots/
RUN chmod -R a+rX /opt/topogym-assets
ENV WARP_CACHE_PATH=/opt/warp-cache
COPY images/robotangle/warp_precompile.py /tmp/warp_precompile.py
RUN python /tmp/warp_precompile.py && rm /tmp/warp_precompile.py && chmod -R a+rX,a-w /opt/warp-cache
RUN --mount=type=bind,from=instances,target=/tmp/mj-instances \
    set -e; for d in /tmp/mj-instances/*/; do [ -d "$d" ] || continue; b=$(basename "$d"); test -f "$d/instance.json"; \
      python -c "import json, sys; assert json.load(open(sys.argv[1]))['simulator']['physics_engine'] == 'mujoco'" "$d/instance.json"; \
      rm -rf "/opt/robotangle/instances/$b"; cp -a "$d" "/opt/robotangle/instances/$b"; \
      chmod -R a+rX "/opt/robotangle/instances/$b"; echo "MuJoCo instance $b"; done; \
    if ls /tmp/mj-instances/*/instance.json > /dev/null 2>&1; then \
      find /opt/robotangle/instances -mindepth 1 -maxdepth 1 -name '*-i00' -exec rm -rf {} + ; \
      echo "removed the base image's Genesis instances: $(ls /opt/robotangle/instances | grep -c -- '-i00$') left"; fi
# The release image (instances in the context) drops the Genesis release's -i00 instances inherited from the base: no
# task of this release uses them. They are removed from the image's filesystem only: the files remain in the
# base image's layers, and the image is not smaller (a squashed image is planned). The image without instances keeps them
# (a new base may read a released instance while it is made).
# MuJoCo 3.14.0 + the EPA horizon-overflow fix (RoboARC 0.2.1), as IKEA ships it: a 14-byte patch of the wheel's own
# libmujoco.so (mujoco-3.14.0-epa/, docs/simulator/MUJOCO_EPA_PATCH.md, upstream 6d662aed; sha256 5e7623e3... ->
# 52e2a24e..., the script asserts both and every original byte). The last step of this stage, so every layer above
# stays the released one; gated on every RoboARC reference (Zen 4 and Intel replays reach the same end states,
# stock = patched).
COPY images/robotangle/mujoco-3.14.0-epa/bytepatch_libmujoco.py /tmp/bytepatch_libmujoco.py
RUN PYTHONDONTWRITEBYTECODE=1 python /tmp/bytepatch_libmujoco.py /usr/local/lib/python3.11/site-packages/mujoco/libmujoco.so.3.14.0 \
 && rm /tmp/bytepatch_libmujoco.py \
 && echo "52e2a24e927ccac047b13576ff9fcbe455bc9a12b0d2e0bf1868bb7ca5be2e4d  /usr/local/lib/python3.11/site-packages/mujoco/libmujoco.so.3.14.0" | sha256sum -c -

# The image that ships: one filesystem layer. A stage FROM scratch takes the merged filesystem of the
# stage above, so files that stage removed (the Genesis -i00 instances inherited from the base) are in no layer of it.
# FROM scratch keeps no configuration: every field of the stage above is declared again, value for value and in its
# order (the base image's environment, pinned by its digest above, then this file's own ENV). Build the unsquashed stage
# with `--target unsquashed` to compare the two.
FROM scratch
COPY --from=unsquashed / /
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    GPG_KEY=A035C8C19219BA821ECEA86B64E628F8D684696D \
    PYTHON_VERSION=3.11.15 \
    PYTHON_SHA256=272179ddd9a2e41a0fc8e42e33dfbdca0b3711aa5abf372d3f2d51543d09b625 \
    TOPOGYM_CUDA_FLAVOR=cu128 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOPOGYM_VISUAL_ASSET_ROOT=/opt/topogym-visuals \
    TOPOGYM_ASSET_ROOT=/opt/topogym-assets \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    XDG_CACHE_HOME=/opt/rcb-cache \
    CUDA_CACHE_PATH=/opt/rcb-cache/nv/ComputeCache \
    PYTHONPATH=/opt/topogym \
    TOPOGYM_SOURCE=/opt/topogym/SOURCE.json \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
    WARP_CACHE_PATH=/opt/warp-cache
WORKDIR /app
CMD ["python3"]
# Labels only (no filesystem change): images/roboarc/build.sh passes the release version.
ARG RELEASE_VERSION=dev
LABEL org.opencontainers.image.title="RoboARC" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.source="https://github.com/Embodied-First-Exam/RoboARC"
