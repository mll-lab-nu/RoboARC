# MuJoCo 3.14.0 libmujoco.so, stock and with the EPA horizon backport (upstream 3.15+: horizon buffers sized
# 24 + max(0, ccd_iterations - 35), bounds-checked in addEdge, warning + no contact on overflow).
# Toolchain: clang/lld 20 (the PyPI 3.14.0 wheel's libmujoco.so says clang 20.1.8 + LLD 20.1.8), upstream's default
# Release CMake options (their AVX setting), no extra flags.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg ca-certificates git cmake ninja-build \
 && wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor > /usr/share/keyrings/llvm.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/trixie/ llvm-toolchain-trixie-20 main" > /etc/apt/sources.list.d/llvm.list \
 && apt-get update && apt-get install -y --no-install-recommends clang-20 lld-20 llvm-20 \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 3.14.0 https://github.com/google-deepmind/mujoco.git /src && git -C /src log -1 --format=%H > /src_commit
COPY mujoco-3.14.0-epa-horizon-backport.patch /patch
ARG JOBS=8
RUN for v in stock patched; do \
      rm -rf /w && cp -r /src /w && if [ $v = patched ]; then git -C /w apply /patch; fi && \
      cmake -S /w -B /b_$v -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang-20 -DCMAKE_CXX_COMPILER=clang++-20 \
        -DCMAKE_SHARED_LINKER_FLAGS=-fuse-ld=lld -DMUJOCO_BUILD_EXAMPLES=OFF -DMUJOCO_BUILD_TESTS=OFF \
        -DMUJOCO_BUILD_SIMULATE=OFF -DMUJOCO_TEST_PYTHON_UTIL=OFF > /cmake_$v.log && \
      ninja -C /b_$v -j $JOBS -v mujoco > /ninja_$v.log && mkdir -p /out/$v && cp -L /b_$v/lib/libmujoco.so.3.14.0 /out/$v/ ; done \
 && (clang-20 --version; ld.lld-20 --version; cmake --version | head -1; cat /src_commit; grep -m1 -o "clang-20 .*engine_collision_gjk.c" /ninja_patched.log) > /out/toolchain.txt \
 && cp /cmake_*.log /ninja_*.log /out/ && sha256sum /out/*/libmujoco.so.3.14.0 >> /out/toolchain.txt
